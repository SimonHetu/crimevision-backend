generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TimePeriod {
  jour
  nuit
  soir
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Pdq {
  id        Int    @id
  name      String @default("")
  address   String @default("")
  cityCode  String @default("")
  latitude  Float  @default(0)
  longitude Float  @default(0)

  incidents Incident[]
}

model Incident {
  id       Int    @id @default(autoincrement())
  source   String
  sourceId String

  category          String
  sourceCategory    String?
  sourceSubcategory String?
  severity          String?

  city    String?
  region  String?
  country String?

  date          DateTime
  occurredAt    DateTime?
  occurredAtEnd DateTime?
  reportedAt    DateTime?
  timePeriod    TimePeriod?

  x         Float?
  y         Float?
  longitude Float?
  latitude  Float?

  policeDistrict String?
  precinct       String?
  borough        String?
  neighborhood   String?
  locationType   String?
  premiseType    String?

  victimAgeGroup  String?
  victimSex       String?
  victimRace      String?
  suspectAgeGroup String?
  suspectSex      String?
  suspectRace     String?
  weapon          String?
  domesticRelated Boolean?
  hateCrime       Boolean?
  shootingRelated Boolean?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pdqId Int?
  pdq   Pdq? @relation(fields: [pdqId], references: [id])

  @@unique([source, sourceId], name: "source_sourceId")
  @@index([source, date])
  @@index([city, date])
  @@index([pdqId, date])
  @@index([date])
  @@index([category])
  @@index([category, date])
  @@index([pdqId, category, date])
  @@index([latitude, longitude])
}

model ImportCursor {
  source       String    @id
  lastDate     DateTime?
  lastSourceId String?
  lastRunAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ImportBootstrapState {
  id         String   @id @default("spvm_incidents_bootstrap")
  source     String   @unique
  nextOffset Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model DataSource {
  id        String  @id
  name      String
  city      String?
  region    String?
  country   String?
  provider  String?
  sourceUrl String?

  supportsPointLocation Boolean @default(false)
  supportsVictimFields  Boolean @default(false)
  supportsSuspectFields Boolean @default(false)
  supportsSexCrimes     Boolean @default(false)
  supportsHomicide      Boolean @default(false)
  supportsReportedDate  Boolean @default(false)
  supportsOccurredTime  Boolean @default(false)

  coverage  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportRun {
  id         Int       @id @default(autoincrement())
  source     String
  mode       String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  fetchedCount  Int @default(0)
  insertedCount Int @default(0)
  updatedCount  Int @default(0)
  skippedCount  Int @default(0)
  errorCount    Int @default(0)

  message  String?
  metadata Json?

  @@index([source, startedAt])
  @@index([status, startedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clerkId                      String?   @unique
  email                        String?   @unique
  passwordHash                 String?
  stripeCustomerId             String?   @unique
  subscriptionStatus           String    @default("none")
  subscriptionCurrentPeriodEnd DateTime?

  role Role @default(USER)

  profile   UserProfile?
  locations SavedLocation[]
  payments  Payment[]
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  homeLat     Float?
  homeLng     Float?
  homeRadiusM Int?
}

model SavedLocation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String
  lat     Float
  lng     Float
  radiusM Int
}

model Payment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String  @unique
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePaymentIntentId   String?

  mode        String
  status      String
  amountTotal Int?
  currency    String?

  @@index([userId, createdAt])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}
